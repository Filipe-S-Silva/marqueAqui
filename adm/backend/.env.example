NODE_ENV=development
HOST=127.0.0.1
PORT=3334
DATABASE_URL=postgres://marqueaqui:marqueaqui_dev@127.0.0.1:5432/marqueaqui
# Gere segredos com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Pepper do HMAC-SHA256 do e-mail dos administradores. Só existe aqui; perdê-lo invalida todos os logins de admin.
ADMIN_EMAIL_PEPPER=
CORS_ORIGIN=http://localhost:5174
# Pepper de senha (>= 32). IGUAL ao PASSWORD_PEPPER do app/backend e do packages/database. Obrigatório em produção.
PASSWORD_PEPPER=
# Duração da sessão do painel em dias (1 a 30).
ADMIN_SESSION_TTL_DAYS=7
# true = todo administrador é obrigado a ativar o 2FA (TOTP) antes de usar o painel.
ADMIN_REQUIRE_2FA=false
DEFAULT_PASSWORD=easyService
TRUST_PROXY=false
LOG_LEVEL=info

# Rate limit compartilhado entre as duas APIs (ex.: Upstash: rediss://default:SENHA@host:6379). Vazio = memória por instância.
# Se o Redis cair a API continua, mas o limite de requisições deixa de valer até ele voltar.
REDIS_URL=
