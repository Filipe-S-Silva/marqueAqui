# API do APP (porta 3333). Copie para .env. Nunca versione o .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3333

# Mesmo banco do docker-compose.yml (credenciais exclusivas de desenvolvimento)
DATABASE_URL=postgres://marqueaqui:marqueaqui_dev@localhost:5432/marqueaqui

# Segredo do JWT. Mínimo 32 caracteres. Gere um valor próprio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Origens permitidas no CORS, separadas por vírgula. Sem curinga.
CORS_ORIGIN=http://localhost:5173

# Inatividade (spec 11)
INACTIVITY_DAYS=45
INACTIVITY_SWEEP_MINUTES=360
# Agendamentos concluídos, cancelados ou faltas são apagados após este número de meses (avaliações permanecem)
RETENTION_MONTHS=3

# Sessão: access token curto + refresh token em cookie HttpOnly
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# true em produção (HTTPS). Em desenvolvimento local pode ser false.
COOKIE_SECURE=false

# Senha padrão de contas novas e redefinidas (troca obrigatória no primeiro acesso).
# Mantenha igual à de packages/database/.env. Em produção, avalie outra estratégia (veja README).
DEFAULT_PASSWORD=easyService

# Atrás de proxy reverso, defina true para o IP real nos limites de taxa
TRUST_PROXY=false
LOG_LEVEL=info

# Pepper de senha (>= 32). IGUAL ao PASSWORD_PEPPER do adm/backend e do packages/database. Obrigatório em produção.
PASSWORD_PEPPER=

# Rate limit compartilhado entre as duas APIs (ex.: Upstash: rediss://default:SENHA@host:6379). Vazio = memória por instância.
# Se o Redis cair a API continua, mas o limite de requisições deixa de valer até ele voltar.
REDIS_URL=
