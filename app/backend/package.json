{
  "name": "@marqueaqui/app-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API do APP: clientes, profissionais e gestores (porta 3333)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/utils.test.ts",
    "db:generate": "npm run db:generate -w @marqueaqui/database",
    "db:migrate": "npm run db:migrate -w @marqueaqui/database",
    "db:seed": "npm run db:seed -w @marqueaqui/database",
    "users:sweep": "tsx src/jobs/sweep-cli.ts",
    "test:integration": "node --test tests/security.integration.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@marqueaqui/database": "*",
    "@marqueaqui/rate-limit": "*",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
