{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "echo build",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/handler" }],
  "functions": {
    "api/handler.mjs": {
      "maxDuration": 30,
      "includeFiles": "{src/**,../../packages/*/package.json,../../packages/*/src/**,../../node_modules/**}"
    }
  },
  "crons": [{ "path": "/internal/maintenance", "schedule": "0 6 * * *" }]
}
