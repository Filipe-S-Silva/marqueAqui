# Usado por drizzle-kit (db:generate), db:migrate e db:seed.
# Credenciais EXCLUSIVAS de desenvolvimento, iguais às do docker-compose.yml.
DATABASE_URL=postgres://marqueaqui:marqueaqui_dev@localhost:5432/marqueaqui

# Senha padrão aplicada a gestores e profissionais criados e a senhas redefinidas. Troca obrigatória no primeiro acesso.
# O valor do exemplo é o definido na especificação do projeto. Use o mesmo valor em app/backend.
DEFAULT_PASSWORD=easyService

# Senha dos clientes de teste criados pelo seed (somente desenvolvimento).
SEED_CLIENT_PASSWORD=Cliente@2026

# Pepper de senha (>= 32 caracteres). TEM de ser igual ao PASSWORD_PEPPER do app/backend e do adm/backend.
# Vazio = sem pepper (só desenvolvimento). Perder o pepper invalida todas as senhas.
PASSWORD_PEPPER=
